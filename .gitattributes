# Keep line endings deterministic. Shell scripts and Dockerfiles MUST stay LF,
# otherwise they break when executed inside Linux containers.
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
Caddyfile   text eol=lf
*.go        text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf

*.png binary
*.jpg binary
*.ico binary

