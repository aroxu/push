# ---------------------------------------------------------------------------
# Copy to .env and change EVERY secret before exposing this to the internet.
#   cp .env.example .env
#   ./scripts/gen-secrets.sh   (prints ready-to-paste values)
# ---------------------------------------------------------------------------

# Public URL handed back to uploaders. Must match how users reach the service.
PUSH_PUBLIC_URL=https://push.example.com

# local writes directly below /data; garage uses the S3 settings below.
PUSH_STORAGE=local

# Hostname Caddy should serve. Use ":80" for plain local HTTP without TLS.
PUSH_SITE_ADDRESS=push.example.com

# --- Garage cluster secrets (hex) ------------------------------------------
# openssl rand -hex 32
GARAGE_RPC_SECRET=change-me-64-hex-characters

# --- S3 credentials issued by Garage ---------------------------------------
# Created automatically on first boot by the bootstrap container.
PUSH_S3_ACCESS_KEY=change-me
PUSH_S3_SECRET_KEY=change-me

# --- Limits -----------------------------------------------------------------
PUSH_MAX_UPLOAD=32GB
PUSH_PART_SIZE=16MB
PUSH_PART_CONCURRENCY=8
PUSH_UPLOAD_SLOTS=32

# --- Retention --------------------------------------------------------------
PUSH_RETENTION=24h
PUSH_LOG_RETENTION=168h

# --- Abuse control ----------------------------------------------------------
PUSH_RATE_PER_MIN=60
PUSH_RATE_BURST=30

# --- Dozzle (log viewer) ----------------------------------------------------
# htpasswd-style bcrypt hash. Generate with:
#   docker run --rm amir20/dozzle:latest generate --name admin --password 'yourpass' --email you@example.com
DOZZLE_USER=admin
DOZZLE_PASSWORD_HASH=change-me
